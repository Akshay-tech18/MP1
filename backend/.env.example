# Server Port
PORT=5001

# Node Environment
NODE_ENV=development

# Database Connections (Neon Serverless PostgreSQL)
# PgBouncer pooled connection string (used for application runtime)
# IMPORTANT: Append ?connection_limit=20&pool_timeout=10 to avoid pool exhaustion on Neon
DATABASE_URL="postgresql://user:password@host-pool.neon.tech/dbname?sslmode=require&connection_limit=20"
# Direct connection string (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@host-direct.neon.tech/dbname?sslmode=require"

# JWT Token Secrets
JWT_ACCESS_SECRET="your_jwt_access_token_secret_minimum_64_bytes_long"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_minimum_64_bytes_long"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:5001/api/auth/google/callback"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:5001/api/auth/github/callback"

# Application Encryption Key (for storing GitHub OAuth tokens)
ENCRYPTION_KEY="your_32_byte_hex_encryption_key_here_for_crypto"

# GitHub Webhook Global Config
GITHUB_WEBHOOK_URL="http://localhost:5001/api/webhooks/github"

# ML Python Service Config
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_API_KEY="your_ml_service_api_secret_key"

# CORS Origin Allowed
CORS_ORIGIN="http://localhost:3000"

# AI / Nexus RAG Services
GROQ_API_KEY="your_groq_api_key_here"
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"
